# Copy to .env (cp .env.example .env) and run everything from the backend/ directory.
# Defaults match the local Docker stack (deploy/docker-compose.yml).
# Empty values mean "use the default". Never commit .env.

# ---- General ----------------------------------------------------------------------------
APP_ENV=development              # development | production (production refuses public APIs)
LOG_LEVEL=INFO
# optional shared key (X-API-Key header); empty = no auth
API_KEY=
CORS_ORIGINS=[]                  # e.g. ["http://localhost:3000"] for a browser client
STATIONS_FILE=data/stations.json # seed for station_config (+ simulation profiles; synthetic)

# ---- Apache IoTDB (raw station / device samples) ------------------------------------------
TIMESERIES_BACKEND=iotdb         # iotdb | memory (memory: demos/tests only)
IOTDB_HOST=127.0.0.1
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=root
IOTDB_ROOT=root.mes              # <root>.<station>.<device>.<metric>, <root>.<station>._station.<metric>
IOTDB_POOL_SIZE=4

# ---- openGauss (station configuration, analysis results, conversations) ----------------------
# Empty = stations read from STATIONS_FILE, results and conversations kept in memory.
# Create user/database/tables (and seed the stations) with:
#   python scripts/init_db.py --admin-dsn "host=127.0.0.1 port=15432 dbname=postgres user=gaussdb password=Gauss@Local2026"
OPENGAUSS_DSN="host=127.0.0.1 port=15432 dbname=industrial_ai user=app_ai password=AppAi@Local2026"

# ---- LLM (OpenAI-compatible) -------------------------------------------------------------------
LLM_PROVIDER=none                # none | deepseek (dev, public API) | vllm (local model)
# or DEEPSEEK_API / DEEPSEEK_API_KEY (used for deepseek only)
LLM_API_KEY=
# DEEPSEEK_API_KEY=
# deepseek default https://api.deepseek.com ; vllm http://127.0.0.1:8000/v1
LLM_BASE_URL=
# deepseek default deepseek-chat ; vllm: --served-model-name
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_ENABLE_THINKING=false        # vLLM/Qwen3; vLLM needs --enable-auto-tool-choice --tool-call-parser hermes

# ---- Agent ---------------------------------------------------------------------------------------
AGENT_MAX_TOOL_ROUNDS=4          # tool-call rounds per question before a forced answer
AGENT_HISTORY_MESSAGES=20        # earlier messages sent as context
AGENT_MAX_INPUT_CHARS=4000

# ---- GLM embedding + Milvus knowledge base ---------------------------------------------------------
# Build the knowledge base with: python scripts/build_knowledge.py
EMBEDDING_PROVIDER=none          # none | zhipu (dev, public API) | local (private deployment)
# or GLM_API_KEY / ZHIPU_API_KEY (used for zhipu only)
EMBEDDING_API_KEY=
# GLM_API_KEY=
# zhipu default https://open.bigmodel.cn/api/paas/v4
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024        # 256 | 512 | 1024 | 2048; changing it requires a rebuild
EMBEDDING_BATCH_SIZE=16
MILVUS_URI=http://127.0.0.1:19530  # empty = knowledge search off
MILVUS_TOKEN=
KB_NAME=nuclear_kb               # alias of the active version; collections <name>__<version>
KB_TOP_K=5
KB_MIN_SCORE=0.3
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_CLASSIFICATIONS=["public","internal"]
# pin queries to one version (default: the active one)
KB_VERSION=

# ---- Ingestion: simulator / MQTT -> IoTDB ------------------------------------------------------------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPICS=["sim/stations/#"]
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# set for a persistent session (broker keeps messages)
MQTT_CLIENT_ID=
MQTT_QOS=1
INGEST_PARSER=simulator          # simulator | mapping | module:Class
# for mapping, e.g. data/mqtt/mapping.example.json
INGEST_MAPPING_FILE=
INGEST_TOPIC_PREFIX=sim/stations
INGEST_BATCH_SIZE=500
INGEST_FLUSH_SECONDS=1.0
INGEST_REJECT_UNKNOWN_DEVICES=true
DEMO_SIMULATION=false            # generate simulated data inside the API (database-free demos)
SIMULATOR_BACKFILL_HOURS=48
SIMULATOR_SEED=42

# ---- Daily station analysis ------------------------------------------------------------------------
ANALYSIS_TIMEZONE=Asia/Shanghai  # defines the calendar day analysed ("yesterday")
ANALYSIS_VERSION=v1              # idempotency key with the date; bump when rules change
ANALYSIS_SCHEDULE_ENABLED=true   # run inside the API process (run ONE API instance)
ANALYSIS_RUN_AT=00:30            # local time; analyses the previous calendar day
ANALYSIS_CATCHUP_DAYS=3          # missed days run after a restart
ANALYSIS_MAX_ATTEMPTS=3          # automatic retries of a failed batch
ANALYSIS_RETRY_MINUTES=10
ANALYSIS_CONSECUTIVE_SAMPLES=3   # samples beyond a threshold that open (and close) an interval
ANALYSIS_GAP_INTERVALS=3         # gap > N sampling intervals = missing data
ANALYSIS_STUCK_MINUTES=60        # identical readings this long = stuck detector
ANALYSIS_MIN_COMPLETENESS=0.9    # daily completeness below this = data-quality event
ANALYSIS_FAULT_LEVEL=inspect     # device fault -> inspect (需检修) | watch; to be confirmed
ANALYSIS_CHARGE_FACTOR=1.5       # slow charging = longer than factor x expected charge time
ANALYSIS_MAX_EVENT_VALUES=3000   # samples stored per event for the frontend chart
ANALYSIS_USE_LLM=true            # explanations by the LLM (if LLM_PROVIDER set), else templates
