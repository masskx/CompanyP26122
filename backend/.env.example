# Copy to .env and fill in. Never commit the real .env.

APP_ENV=development
LOG_LEVEL=INFO

# Bearer token the MES main backend must present. Leave empty to reject all
# business requests (fail closed).
COMPUTE_SERVICE_TOKEN=

# Equipment master data (placeholder until the MES equipment API is available).
EQUIPMENT_CATALOG_PATH=examples/equipment_catalog.example.json

# ---- Time-series storage (product not finalised) ----
# memory | iotdb
TIMESERIES_BACKEND=memory
IOTDB_HOST=127.0.0.1
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=
IOTDB_ROOT_PATH=root.mes
IOTDB_POOL_SIZE=4

# ---- Analysis results / assistant sessions (database not finalised) ----
# Only "memory" is implemented today; data is lost on restart.
ANALYSIS_STORE_BACKEND=memory
SESSION_STORE_BACKEND=memory

# ---- Rules ----
HEALTH_WINDOW_HOURS=24
MIN_DATA_COMPLETENESS=0.8
CONSECUTIVE_BREACH_COUNT=3
ANALYSIS_MAX_RANGE_DAYS=90

# ---- Streaming ----
SSE_HEARTBEAT_SECONDS=15

# ---- Model / RAG (not wired yet; reported by /health endpoints) ----
VLLM_BASE_URL=
VLLM_MODEL_NAME=
KNOWLEDGE_INDEX_VERSION=
