# Copy to .env (cp .env.example .env) and run everything from the backend/ directory.
# Defaults match the local Docker stack (deploy/docker-compose.yml).
# Empty values mean "use the default". Never commit .env.

# ---- General ----------------------------------------------------------------------------
APP_ENV=development              # development | production (production refuses public APIs)
LOG_LEVEL=INFO
# Service authentication. The main server sends "Authorization: Bearer <COMPUTE_SERVICE_TOKEN>"
# (design doc); API_KEY is the X-API-Key header the current Go proxy sends
# (COMPUTE_SERVICE_API_KEY there). Either one authorises; both empty = open (local use).
COMPUTE_SERVICE_TOKEN=
API_KEY=
CORS_ORIGINS=[]                  # e.g. ["http://localhost:3000"] for a browser client
# Station directory snapshot (codes / names from the prototype; thresholds are SYNTHETIC)
STATIONS_FILE=data/stations.json
ANALYSIS_TIMEZONE=Asia/Shanghai  # local time for reports, "yesterday", last month / last year

# ---- Apache IoTDB (raw station / device samples) ------------------------------------------
TIMESERIES_BACKEND=iotdb         # iotdb | memory (memory: demos/tests only)
IOTDB_HOST=127.0.0.1
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=root
IOTDB_ROOT=root.mes              # <root>.<site>.<equipment>.<metric> (+ <root>._sys.ingest.watermark)
IOTDB_POOL_SIZE=4

# ---- openGauss (conversations + copy of the main server's work orders) ----------------------
# Empty = both kept in memory (demos). Create user / database / tables with:
#   python scripts/init_db.py --admin-dsn "host=127.0.0.1 port=15432 dbname=postgres user=gaussdb password=Gauss@Local2026"
OPENGAUSS_DSN="host=127.0.0.1 port=15432 dbname=industrial_ai user=app_ai password=AppAi@Local2026"

# ---- LLM (OpenAI-compatible) -------------------------------------------------------------------
LLM_PROVIDER=none                # none | deepseek (dev, public API) | vllm (local model)
# or DEEPSEEK_API / DEEPSEEK_API_KEY (used for deepseek only)
LLM_API_KEY=
# DEEPSEEK_API_KEY=
# deepseek default https://api.deepseek.com ; vllm e.g. http://172.16.103.222:8000/v1 (with /v1)
# (VLLM_BASE_URL is accepted too)
LLM_BASE_URL=
# deepseek default deepseek-chat ; vllm: the --served-model-name, e.g. qwen3-14b (or VLLM_MODEL_NAME)
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_ENABLE_THINKING=false        # vLLM/Qwen3; vLLM needs --enable-auto-tool-choice --tool-call-parser hermes
# shown in analysis results (versions.model); the model list is authoritative
LLM_MODEL_PRECISION=以模型清单为准
LLM_MODEL_REVISION=以模型清单为准

# ---- Agent ---------------------------------------------------------------------------------------
AGENT_MAX_TOOL_ROUNDS=4          # tool-call rounds per question before a forced answer
AGENT_HISTORY_MESSAGES=20        # earlier messages sent as context
AGENT_MAX_INPUT_CHARS=4000

# ---- GLM embedding + Milvus knowledge base ---------------------------------------------------------
# Build the knowledge base with: python scripts/build_knowledge.py
EMBEDDING_PROVIDER=none          # none | zhipu (dev, public API) | local (private deployment)
# or GLM_API_KEY / ZHIPU_API_KEY (used for zhipu only)
EMBEDDING_API_KEY=
# GLM_API_KEY=
# zhipu default https://open.bigmodel.cn/api/paas/v4
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024        # 256 | 512 | 1024 | 2048; changing it requires a rebuild
EMBEDDING_BATCH_SIZE=16
MILVUS_URI=http://127.0.0.1:19530  # empty = knowledge search off
MILVUS_TOKEN=
KB_NAME=nuclear_kb               # alias of the active version; collections <name>__<version>
KB_TOP_K=5
KB_MIN_SCORE=0.3
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_CLASSIFICATIONS=["public","internal"]
# pin queries to one version (default: the active one); KNOWLEDGE_INDEX_VERSION is accepted too
KB_VERSION=
# corpus for scripts/build_knowledge.py (.md .txt .pdf .docx + optional manifest.json)
KB_CORPUS_PATH=data/knowledge
# Optional local rerank model (vLLM --task score / TEI / Jina-compatible POST <url>/rerank)
RERANK_BASE_URL=
RERANK_MODEL_NAME=
RERANK_API_KEY=
KB_RERANK_CANDIDATES=20          # vector hits handed to the reranker

# ---- Ingestion: MQTT (main server, telemetry_v1 contract) / simulator -> IoTDB -------------------------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPICS=["maintenance/v1/#"]
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# set for a persistent session (broker keeps messages)
MQTT_CLIENT_ID=
MQTT_QOS=1
INGEST_PARSER=telemetry_v1       # telemetry_v1 | mapping | module:Class
# for mapping, e.g. data/mqtt/mapping.example.json
INGEST_MAPPING_FILE=
INGEST_TOPIC_PREFIX=maintenance/v1
INGEST_BATCH_SIZE=500
INGEST_FLUSH_SECONDS=1.0
INGEST_REJECT_UNKNOWN_DEVICES=true
DEMO_SIMULATION=false            # generate simulated data inside the API (database-free demos)
SIMULATOR_BACKFILL_HOURS=48
SIMULATOR_SEED=42

# ---- Predictive maintenance analysis (POST /internal/v1/maintenance/analyses) --------------------
# Main server read-only history API; empty = use the work-order copy the main server pushes here
MES_API_BASE_URL=
MES_SERVICE_TOKEN=
ANALYSIS_WATERMARK_WAIT_SECONDS=30   # wait for the local MQTT watermark to reach the request's
ANALYSIS_WATERMARK_POLL_MS=500
ANALYSIS_MAX_WINDOW_DAYS=31
ANALYSIS_IDEMPOTENCY_TTL_SECONDS=3600  # same Idempotency-Key -> same result for this long
MAINTENANCE_RULE_SET_VERSION=maintenance-rules-2026.11.1
MAINTENANCE_ACTION_CATALOG_PATH=data/maintenance/actions.json
MAINTENANCE_NARRATOR_PROMPT_VERSION=maintenance-narrator-v1
# explanation model (default: LLM_MODEL)
MAINTENANCE_NARRATOR_MODEL_NAME=
MAINTENANCE_NARRATOR_TIMEOUT_SECONDS=30
MAINTENANCE_NARRATOR_MAX_CHARS=300
MAINTENANCE_USE_LLM=true             # false = rule template explanations only
ANALYSIS_CONSECUTIVE_SAMPLES=3       # samples beyond a threshold that open (and close) an interval
ANALYSIS_GAP_INTERVALS=3             # gap > N sampling intervals = data gap
ANALYSIS_STUCK_MINUTES=60            # identical readings this long = stuck detector
ANALYSIS_MIN_COMPLETENESS=0.8        # key metric below this = insufficient_data
ANALYSIS_FAULT_LEVEL=inspect         # reported device fault -> inspect | watch
ANALYSIS_CHARGE_FACTOR=1.5           # slow recharge = longer than factor x expected time
ANALYSIS_BASELINE_DAYS=14            # baseline window (前两周)
ANALYSIS_RISE_WATCH_PCT=30           # dose-rate rise vs baseline that counts as a trend
ANALYSIS_RUNTIME_DROP_WATCH_PCT=15   # reference runtime drop -> watch
ANALYSIS_RUNTIME_DROP_INSPECT_PCT=25 # ... -> inspect
ANALYSIS_HISTORY_LOOKBACK_DAYS=90    # history used by the assistant's checks

# ---- Assistant workflows and reports -------------------------------------------------------------
ASSISTANT_INTENT_MODEL=true          # classify free-form messages into a workflow with the model
REPORTS_DIR=var/reports              # generated Excel files (object storage later)
REPORT_MAX_DAYS=92
SSE_HEARTBEAT_SECONDS=15
