# =============================================================================
# industrial-ai backend configuration
#
#   cp .env.example .env        (run everything from the backend/ directory)
#
# Defaults below match the local Docker stack in deploy/docker-compose.yml.
# Using your own servers? Change the host/port/credentials in sections 2-5.
# Empty values (KEY=) mean "use the built-in default". Lines starting with "#"
# are optional settings shown with their defaults.
# Never commit the real .env (it is git-ignored).
# =============================================================================

# ---- 1. General -------------------------------------------------------------
APP_ENV=development            # development | production (production refuses public APIs and dev identity)
LOG_LEVEL=INFO

# Bearer token the MES main backend must send on every /internal/v1 request.
# Pick any long random string; the smoke test and your API calls use the same value.
COMPUTE_SERVICE_TOKEN=local-dev-token-change-me

# ---- 2. Apache IoTDB (time series) -----------------------------------------
TIMESERIES_BACKEND=iotdb       # iotdb | memory (memory = no IoTDB, data lost on restart)
IOTDB_HOST=127.0.0.1
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=root            # IoTDB's default; change it on shared servers
IOTDB_ROOT_PATH=root.mes       # series are <root>.<site_id>.<equipment_id>.<metric>
IOTDB_POOL_SIZE=4
# IOTDB_WAIT_TIMEOUT_MS=3000
# IOTDB_ENABLE_REDIRECTION=false   # only useful on multi-node clusters

# ---- 3. openGauss (users, chat sessions, messages, citations, feedback) ----
SESSION_STORE_BACKEND=opengauss   # opengauss | memory
# Application login. scripts/init_databases.py --opengauss --opengauss-admin-dsn "..."
# creates this user, a DBCOMPATIBILITY 'PG' database and a schema named after the user.
OPENGAUSS_DSN="host=127.0.0.1 port=15432 dbname=industrial_ai user=app_ai password=AppAi@Local2026"
OPENGAUSS_POOL_MIN=1
OPENGAUSS_POOL_MAX=10

# ---- 4. Milvus (knowledge base vectors) ------------------------------------
MILVUS_URI=http://127.0.0.1:19530   # empty = knowledge search disabled
# MILVUS_TOKEN=user:password        # if Milvus authentication is enabled
# MILVUS_DB_NAME=default
KB_ALIAS=nuclear_kb                 # alias -> active version; collections are <alias>__<version>
KB_INDEX_TYPE=HNSW
KB_TOP_K=5
KB_MIN_SCORE=0.3                    # cosine similarity floor; lower hits are dropped
KB_ALLOWED_CLASSIFICATIONS=["public","internal"]
KB_CHUNK_CHARS=800
KB_CHUNK_OVERLAP=120
# KNOWLEDGE_INDEX_VERSION=          # pin queries to one version instead of following the alias

# ---- 5. MQTT broker ----------------------------------------------------------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPICS=["sim/radiation/#"]     # JSON list
MQTT_QOS=1
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_FILE=
MQTT_CLIENT_ID=                     # required when MQTT_PERSISTENT_SESSION=true
MQTT_PERSISTENT_SESSION=false
# MQTT_KEEPALIVE=60

# ---- 6. AI: LLM (assistant + analysis explanations) -------------------------
# none     -> assistant chat returns 503; analyses use rule text only
# deepseek -> DeepSeek public API (development/testing only; refused in production)
# vllm     -> your local model served by vLLM (production)
LLM_PROVIDER=none
LLM_API_KEY=                        # or set DEEPSEEK_API_KEY / DEEPSEEK_API (used for deepseek only)
# DEEPSEEK_API_KEY=
LLM_BASE_URL=                       # deepseek default: https://api.deepseek.com ; vllm: http://127.0.0.1:8000/v1
LLM_MODEL=                          # deepseek default: deepseek-chat ; vllm: the --served-model-name
LLM_MODEL_PRECISION=                # e.g. W8A8 (recorded with every answer)
LLM_MODEL_REVISION=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_ENABLE_THINKING=false           # vLLM/Qwen3 only; reasoning text is never shown to users
# vLLM must run with tool calling enabled, e.g. for Qwen3:
#   vllm serve <model> --enable-auto-tool-choice --tool-call-parser hermes

# ---- 7. AI: GLM embedding (knowledge base) -----------------------------------
# Building the index (industrial-ai-kb / init_databases.py --sample-knowledge) and answering
# questions MUST use the same model and dimensions; changing either requires a rebuild.
# none  -> knowledge search disabled
# zhipu -> Zhipu BigModel public API (development only; refused in production)
# local -> privately deployed endpoint with the same API (production)
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=                  # or set GLM_API_KEY / ZHIPU_API_KEY (used for zhipu only)
# GLM_API_KEY=
EMBEDDING_BASE_URL=                 # zhipu default: https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024           # embedding-3: 256 | 512 | 1024 | 2048 ; embedding-2 is fixed at 1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_BATCH_CHARS=2800
# EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_MAX_RETRIES=2

# ---- 8. Assistant -------------------------------------------------------------
ASSISTANT_HISTORY_MESSAGES=20       # earlier messages sent to the model as context
ASSISTANT_MAX_TOOL_STEPS=4
ASSISTANT_TOOL_RESULT_CHARS=8000
ASSISTANT_MAX_ANSWER_TOKENS=2048
# ASSISTANT_MAX_MESSAGE_CHARS=4000

# ---- 9. End-user identity -------------------------------------------------------
# trusted_gateway: X-User-Id / X-User-Name / X-User-Roles forwarded by the MES backend,
#                  accepted only on requests carrying COMPUTE_SERVICE_TOKEN (current design)
# jwt:             signed user token from the client application (header USER_JWT_HEADER)
# dev:             X-User-Id or DEV_DEFAULT_USER, unverified; refused in production
USER_IDENTITY_MODE=trusted_gateway
TRUSTED_GATEWAY_ISSUER=mes-main-backend
# DEV_DEFAULT_USER=dev-user
# USER_JWT_HEADER=X-User-Assertion
# USER_JWT_ALGORITHMS=["RS256"]
# USER_JWT_KEY=                     # HMAC secret (HS256) or PEM public key
# USER_JWT_KEY_FILE=                # alternative: path to the PEM public key
# USER_JWT_ISSUER=
# USER_JWT_AUDIENCE=
# USER_JWT_LEEWAY_SECONDS=30
# USER_JWT_NAME_CLAIM=name
# USER_JWT_ROLES_CLAIM=roles

# ---- 10. Equipment catalog and simulated data -----------------------------------
# The simulation scenario doubles as the equipment catalog for its 7 synthetic devices.
# For real equipment use a file shaped like examples/equipment_catalog.example.json.
EQUIPMENT_CATALOG_PATH=examples/simulation/radiation_scenario.json
SIMULATOR_SCENARIO_PATH=examples/simulation/radiation_scenario.json
SIMULATOR_BACKFILL_HOURS=48         # history generated before live readings start
SIMULATOR_REALTIME=true
SIMULATOR_SEED=42

# ---- 11. Collector (source -> parser -> validator -> IoTDB) ----------------------
COLLECTOR_SOURCE=simulator          # simulator | mqtt (used by industrial-ai-collector run)
# Wire format of incoming messages:
#   provisional_json -> the simulator's format (topic <prefix>/<site>/<equipment>/<metric>)
#   mapping          -> describe the real format in COLLECTOR_PARSER_CONFIG (no code)
#   module:Class     -> your own parser class
COLLECTOR_PARSER=provisional_json
COLLECTOR_PARSER_CONFIG=            # e.g. examples/mqtt/mapping.example.json
COLLECTOR_TOPIC_PREFIX=sim/radiation
COLLECTOR_BATCH_SIZE=500
COLLECTOR_FLUSH_SECONDS=1.0
COLLECTOR_MAX_FUTURE_SKEW_SECONDS=300
COLLECTOR_REJECT_UNKNOWN_EQUIPMENT=true
# COLLECTOR_QUEUE_SIZE=10000
# COLLECTOR_MAX_BUFFER=100000       # points kept in memory while IoTDB is down
# COLLECTOR_MAX_AGE_HOURS=          # reject readings older than this (empty = no limit)
API_EMBEDDED_COLLECTOR=false        # run the simulator inside the API (memory backend demos)

# ---- 12. Rules and analyses ---------------------------------------------------------
HEALTH_WINDOW_HOURS=24
MIN_DATA_COMPLETENESS=0.8
CONSECUTIVE_BREACH_COUNT=3
ANALYSIS_MAX_RANGE_DAYS=90
ANALYSIS_STORE_BACKEND=memory       # analysis results are kept in memory for now
# MAX_EQUIPMENT_PER_ANALYSIS=50
# ANALYSIS_TIMEOUT_SECONDS=300
SSE_HEARTBEAT_SECONDS=15
