# Copy to .env (cp .env.example .env) and run everything from the backend/ directory.
# Defaults match the local Docker stack (deploy/docker-compose.yml).
# Empty values mean "use the default". Never commit .env.

# ---- General ----------------------------------------------------------------------------
APP_ENV=development              # development | production (production refuses public APIs)
LOG_LEVEL=INFO
API_KEY=                         # optional shared key (X-API-Key header); empty = no auth
CORS_ORIGINS=[]                  # e.g. ["http://localhost:3000"] for a browser client
DEVICES_FILE=data/devices.json   # device catalog (+ simulation profiles)

# ---- Apache IoTDB (dose-rate time series) -----------------------------------------------
TIMESERIES_BACKEND=iotdb         # iotdb | memory (memory: demos/tests only)
IOTDB_HOST=127.0.0.1
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=root
IOTDB_ROOT=root.mes              # series: <root>.<site>.<device_id>.<metric>
IOTDB_POOL_SIZE=4

# ---- openGauss (conversations) --------------------------------------------------------------
# Empty = conversations kept in memory. Create user/database/tables with:
#   python scripts/init_db.py --admin-dsn "host=127.0.0.1 port=15432 dbname=postgres user=gaussdb password=Gauss@Local2026"
OPENGAUSS_DSN="host=127.0.0.1 port=15432 dbname=industrial_ai user=app_ai password=AppAi@Local2026"

# ---- LLM (OpenAI-compatible) -------------------------------------------------------------------
LLM_PROVIDER=none                # none | deepseek (dev, public API) | vllm (local model)
LLM_API_KEY=                     # or DEEPSEEK_API / DEEPSEEK_API_KEY (used for deepseek only)
# DEEPSEEK_API_KEY=
LLM_BASE_URL=                    # deepseek default https://api.deepseek.com ; vllm http://127.0.0.1:8000/v1
LLM_MODEL=                       # deepseek default deepseek-chat ; vllm: --served-model-name
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_ENABLE_THINKING=false        # vLLM/Qwen3; vLLM needs --enable-auto-tool-choice --tool-call-parser hermes

# ---- Agent ---------------------------------------------------------------------------------------
AGENT_MAX_TOOL_ROUNDS=4          # tool-call rounds per question before a forced answer
AGENT_HISTORY_MESSAGES=20        # earlier messages sent as context
AGENT_MAX_INPUT_CHARS=4000

# ---- GLM embedding + Milvus knowledge base ---------------------------------------------------------
# Build the knowledge base with: python scripts/build_knowledge.py
EMBEDDING_PROVIDER=none          # none | zhipu (dev, public API) | local (private deployment)
EMBEDDING_API_KEY=               # or GLM_API_KEY / ZHIPU_API_KEY (used for zhipu only)
# GLM_API_KEY=
EMBEDDING_BASE_URL=              # zhipu default https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024        # 256 | 512 | 1024 | 2048; changing it requires a rebuild
EMBEDDING_BATCH_SIZE=16
MILVUS_URI=http://127.0.0.1:19530  # empty = knowledge search off
MILVUS_TOKEN=
KB_NAME=nuclear_kb               # alias of the active version; collections <name>__<version>
KB_TOP_K=5
KB_MIN_SCORE=0.3
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_CLASSIFICATIONS=["public","internal"]
KB_VERSION=                      # pin queries to one version (default: the active one)

# ---- Ingestion: simulator / MQTT -> IoTDB ------------------------------------------------------------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPICS=["sim/radiation/#"]
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=                  # set for a persistent session (broker keeps messages)
MQTT_QOS=1
INGEST_PARSER=simulator          # simulator | mapping | module:Class
INGEST_MAPPING_FILE=             # for mapping, e.g. data/mqtt/mapping.example.json
INGEST_TOPIC_PREFIX=sim/radiation
INGEST_BATCH_SIZE=500
INGEST_FLUSH_SECONDS=1.0
INGEST_REJECT_UNKNOWN_DEVICES=true
DEMO_SIMULATION=false            # generate simulated data inside the API (database-free demos)
SIMULATOR_BACKFILL_HOURS=48
SIMULATOR_SEED=42

# ---- Rules -------------------------------------------------------------------------------------------
RULE_MIN_COMPLETENESS=0.8
RULE_CONSECUTIVE_BREACHES=3
