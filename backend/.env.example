# Copy to .env and fill in. Never commit the real .env.

APP_ENV=development
LOG_LEVEL=INFO

# Bearer token the MES main backend must present. Leave empty to reject all
# business requests (fail closed).
COMPUTE_SERVICE_TOKEN=

# ---- End-user identity (assistant endpoints) ----
# trusted_gateway: X-User-Id / X-User-Name / X-User-Roles from the main backend, accepted
#                  only on requests that carry COMPUTE_SERVICE_TOKEN (current design)
# jwt:             signed user assertion in USER_JWT_HEADER, verified here (recommended
#                  once the client application issues tokens)
# dev:             X-User-Id or DEV_DEFAULT_USER, unverified; refused in production
USER_IDENTITY_MODE=trusted_gateway
TRUSTED_GATEWAY_ISSUER=mes-main-backend
# USER_JWT_HEADER=X-User-Assertion
# USER_JWT_ALGORITHMS=["RS256"]
# USER_JWT_KEY_FILE=/run/secrets/client-idp-public.pem   # or USER_JWT_KEY for HS256
# USER_JWT_ISSUER=<client identity provider>
# USER_JWT_AUDIENCE=industrial-ai
# USER_JWT_ROLES_CLAIM=roles

# Equipment master data (placeholder until the MES equipment API is available).
# The simulation scenario doubles as the catalog for its synthetic devices. For real
# equipment use a file like examples/equipment_catalog.example.json.
EQUIPMENT_CATALOG_PATH=examples/simulation/radiation_scenario.json

# ---- Time-series storage: Apache IoTDB ----
# iotdb (default) | memory (tests / local development without an IoTDB server)
TIMESERIES_BACKEND=iotdb
IOTDB_HOST=127.0.0.1
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=
IOTDB_ROOT_PATH=root.mes
IOTDB_POOL_SIZE=4

# ---- Collector: source -> parser -> validator -> IoTDB ----
# simulator (synthetic dose-rate data) | mqtt (broker subscription)
COLLECTOR_SOURCE=simulator
# Wire format. Only provisional_json exists until the real MQTT contract is known.
COLLECTOR_PARSER=provisional_json
COLLECTOR_TOPIC_PREFIX=sim/radiation
COLLECTOR_BATCH_SIZE=500
COLLECTOR_FLUSH_SECONDS=1.0
COLLECTOR_MAX_FUTURE_SKEW_SECONDS=300
COLLECTOR_REJECT_UNKNOWN_EQUIPMENT=true
# Run the collector inside the API process (dev only; needed for TIMESERIES_BACKEND=memory).
API_EMBEDDED_COLLECTOR=false

# ---- Simulator (synthetic data only; not plant values) ----
SIMULATOR_SCENARIO_PATH=examples/simulation/radiation_scenario.json
SIMULATOR_BACKFILL_HOURS=48
SIMULATOR_REALTIME=true
SIMULATOR_SEED=42

# ---- MQTT (COLLECTOR_SOURCE=mqtt, and `industrial-ai-collector publish-sim`) ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPICS=["sim/radiation/#"]
MQTT_QOS=1
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_FILE=
MQTT_PERSISTENT_SESSION=false

# ---- Conversations: openGauss ----
# memory (tests/dev, lost on restart) | opengauss
SESSION_STORE_BACKEND=memory
# libpq DSN. Use a non-initial user, md5 auth, a DBCOMPATIBILITY 'PG' database and a schema
# owned by the user (see README). Apply the schema with: industrial-ai-db migrate
OPENGAUSS_DSN="host=127.0.0.1 port=5432 dbname=industrial_ai user=app_ai password=change-me"
OPENGAUSS_POOL_MIN=1
OPENGAUSS_POOL_MAX=10
# Maintenance analysis results are still kept in memory.
ANALYSIS_STORE_BACKEND=memory

# ---- Assistant ----
ASSISTANT_HISTORY_MESSAGES=20
ASSISTANT_MAX_TOOL_STEPS=4
ASSISTANT_TOOL_RESULT_CHARS=8000
ASSISTANT_MAX_ANSWER_TOKENS=2048

# ---- Embedding: GLM. Index build (industrial-ai-kb) and queries MUST use the same
# model and dimensions; queries are refused against a collection built differently.
# none | zhipu (public API, dev only, refused in production) | local (private deployment)
EMBEDDING_PROVIDER=none
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4    # default for zhipu
EMBEDDING_API_KEY=           # or GLM_API_KEY / ZHIPU_API_KEY (zhipu only)
EMBEDDING_MODEL=embedding-3
# embedding-3: 256 | 512 | 1024 | 2048 (model default 2048). embedding-2 is fixed at 1024.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_BATCH_CHARS=2800

# ---- Milvus knowledge base ----
MILVUS_URI=
# MILVUS_TOKEN=user:password
KB_ALIAS=nuclear_kb
KB_INDEX_TYPE=HNSW
KB_TOP_K=5
KB_MIN_SCORE=0.3
KB_ALLOWED_CLASSIFICATIONS=["public","internal"]
KB_CHUNK_CHARS=800
KB_CHUNK_OVERLAP=120

# ---- Rules ----
HEALTH_WINDOW_HOURS=24
MIN_DATA_COMPLETENESS=0.8
CONSECUTIVE_BREACH_COUNT=3
ANALYSIS_MAX_RANGE_DAYS=90

# ---- Streaming ----
SSE_HEARTBEAT_SECONDS=15

# ---- LLM ----
# none | deepseek | vllm. Both use the OpenAI-compatible chat-completions API.
#
# Development/testing with DeepSeek (public internet API):
#   - refused when APP_ENV=production
#   - tool calling must be supported (deepseek-chat supports it)
#   - send synthetic or approved desensitised data only, never real plant data
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-...        # or DEEPSEEK_API_KEY / DEEPSEEK_API (DeepSeek only)
# LLM_BASE_URL=https://api.deepseek.com      # default
# LLM_MODEL=deepseek-chat                    # default
#
# Production with the local model served by vLLM:
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=<served model name, i.e. vllm serve --served-model-name>
# LLM_API_KEY=                                # only if vllm was started with --api-key
# LLM_MODEL_PRECISION=W8A8
# LLM_MODEL_REVISION=<from the model manifest>
# vLLM must run with tool calling enabled for the assistant, e.g.
#   --enable-auto-tool-choice --tool-call-parser hermes   (Qwen3)
LLM_PROVIDER=none
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_ENABLE_THINKING=false

# Optional: pin queries to one knowledge version instead of following KB_ALIAS.
KNOWLEDGE_INDEX_VERSION=
